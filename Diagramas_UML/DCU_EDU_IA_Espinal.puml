@startuml
left to right direction

actor "Usuario" as User
actor "Administrador" as Admin

rectangle "Plataforma Web EDU_IA" {
  usecase "Explorar Módulos" as UC1
  usecase "Leer Temas libremente" as UC2
  usecase "Buscar por palabras clave" as UC3
  usecase "Realizar Autoevaluación" as UC4
  
  usecase "Gestionar Contenidos\n(Agregar, Editar, Eliminar)" as UC5
  usecase "Iniciar Sesión\n(Correo y Contraseña)" as UC6
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4

Admin --> UC5
UC5 ..> UC6 : <<include>>
@enduml